# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary formats
*.png binary
*.ico binary
*.bmp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.a binary

# Preserve diagnostic logs byte-for-byte, including original trailing spaces.
docs/evidence/chromium-token-wait-r*-chromium.log -text whitespace=-blank-at-eol
docs/evidence/chromium-token-pipe-r*-helper.stderr.log -text whitespace=-blank-at-eol

# macro used by wine/.gitattributes (macros are only valid in the top-level file)
[attr]generated gitlab-generated linguist-generated=true
