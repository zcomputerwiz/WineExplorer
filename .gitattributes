# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary formats
*.png binary
*.ico binary
*.bmp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.a binary

# macro used by wine/.gitattributes (macros are only valid in the top-level file)
[attr]generated gitlab-generated linguist-generated=true
