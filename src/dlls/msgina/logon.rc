#include "windef.h"
#include "winuser.h"
#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

/* collapsed: OK, Cancel, Options >>; Options shows Shut Down... and moves OK and Cancel left (logon.c). A workgroup
 * machine has no "Log on to" box, and the dialog does not grow. */
IDD_LOGON DIALOGEX 0, 0, 274, 129
STYLE DS_MODALFRAME | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION
CAPTION "Log On to Windows"
FONT 8, "Tahoma"
BEGIN
    CONTROL         "", IDC_LOGON_BANNER, "Static", SS_OWNERDRAW, 0, 0, 274, 57
    LTEXT           "&User name:", -1, 6, 72, 48, 8
    EDITTEXT        IDC_LOGON_USER, 56, 70, 162, 12, ES_AUTOHSCROLL
    LTEXT           "&Password:", -1, 6, 88, 48, 8
    EDITTEXT        IDC_LOGON_PASSWORD, 56, 86, 162, 12, ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON   "OK", IDOK, 109, 108, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 108, 50, 14
    PUSHBUTTON      "&Shut Down...", IDC_LOGON_SHUTDOWN, 163, 108, 50, 14, NOT WS_VISIBLE
    PUSHBUTTON      "&Options >>", IDC_LOGON_OPTIONS, 217, 108, 50, 14
END

STRINGTABLE
{
    IDS_LOGON_TITLE "Logon Message"
    IDS_LOGON_FAILED "The system could not log you on. Make sure your User name and domain are correct, then type your password again. Letters in passwords must be typed using the correct case."
    IDS_LOGON_SESSION "Windows could not start your session."
    IDS_LOGON_OPTIONS "&Options >>"
    IDS_LOGON_FEWER "&Options <<"
    IDS_LOGON_PRODUCT "WineExplorer"
    IDS_LOGON_COPYRIGHT "WineExplorer contributors"
}
