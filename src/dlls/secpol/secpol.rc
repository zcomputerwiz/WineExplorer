#include <windef.h>
#include <winuser.h>
#include <commctrl.h>

#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDM_MAIN MENU
{
    POPUP "&File"
    {
        MENUITEM "E&xit", IDM_EXIT
    }
    POPUP "&Action"
    {
        MENUITEM "&Properties\tAlt+Enter", IDM_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "&Refresh\tF5", IDM_REFRESH
    }
    POPUP "&Help"
    {
        MENUITEM "&About Local Security Settings", IDM_ABOUT
    }
}

IDA_MAIN ACCELERATORS
{
    VK_RETURN, IDM_PROPERTIES, VIRTKEY, ALT
    VK_F5,     IDM_REFRESH,    VIRTKEY
}

/* the Local Security Setting page: a number with its unit, Enabled or Disabled, or one of a list */
IDD_SETTING DIALOGEX 0, 0, 252, 170
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Local Security Setting"
FONT 8, "MS Shell Dlg"
{
    LTEXT        "", IDC_NAME, 10, 10, 232, 24, SS_NOPREFIX
    LTEXT        "", IDC_LABEL, 10, 44, 232, 10
    EDITTEXT     IDC_NUMBER, 10, 58, 50, 12, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL      "", IDC_SPIN, UPDOWN_CLASSA, UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 60, 58, 10, 12
    LTEXT        "", IDC_UNIT, 76, 60, 166, 10
    LTEXT        "", IDC_HINT, 10, 78, 232, 22
    AUTORADIOBUTTON "&Enabled", IDC_ENABLED, 10, 44, 120, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Disabled", IDC_DISABLED, 10, 58, 120, 10
    COMBOBOX     IDC_CHOICE, 10, 44, 232, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT        "", IDC_SUPPORT, 10, 132, 232, 30
}

/* the Explain page */
IDD_EXPLAIN DIALOGEX 0, 0, 252, 170
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Explain"
FONT 8, "MS Shell Dlg"
{
    EDITTEXT     IDC_EXPLAIN, 10, 10, 232, 150, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
}
