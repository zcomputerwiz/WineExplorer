IDD_GENERAL DIALOG 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
{
    ICON "", IDC_DEVICE_ICON, 7, 7, 20, 20
    LTEXT "", IDC_NAME, 37, 13, 208, 8, SS_NOPREFIX
    LTEXT "Device type:", -1, 37, 43, 60, 8
    LTEXT "", IDC_TYPE, 100, 43, 145, 8, SS_NOPREFIX
    LTEXT "Manufacturer:", -1, 37, 57, 60, 8
    LTEXT "", IDC_MANUFACTURER, 100, 57, 145, 8, SS_NOPREFIX
    LTEXT "Location:", -1, 37, 71, 60, 8
    LTEXT "", IDC_LOCATION, 100, 71, 145, 8, SS_NOPREFIX
    GROUPBOX "Device status", -1, 7, 84, 238, 103
    EDITTEXT IDC_STATUS, 14, 96, 224, 61, ES_MULTILINE | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    PUSHBUTTON "&Troubleshoot...", IDC_TROUBLESHOOT, 150, 165, 88, 14
    LTEXT "Device &usage:", IDC_USAGE_LABEL, 7, 192, 100, 8
    COMBOBOX IDC_USAGE, 7, 202, 238, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
}

IDD_DRIVER DIALOG 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Driver"
FONT 8, "MS Shell Dlg"
{
    ICON "", IDC_DEVICE_ICON, 7, 7, 20, 20
    LTEXT "", IDC_NAME, 37, 13, 208, 8, SS_NOPREFIX
    LTEXT "Driver Provider:", -1, 37, 43, 60, 8
    LTEXT "", IDC_PROVIDER, 100, 43, 145, 8, SS_NOPREFIX
    LTEXT "Driver Date:", IDC_DATE_LABEL, 37, 57, 60, 8
    LTEXT "", IDC_DATE, 100, 57, 145, 8, SS_NOPREFIX
    LTEXT "Driver Version:", IDC_VERSION_LABEL, 37, 71, 60, 8
    LTEXT "", IDC_VERSION, 100, 71, 145, 8, SS_NOPREFIX
    LTEXT "Digital Signer:", -1, 37, 85, 60, 8
    LTEXT "", IDC_SIGNER, 100, 85, 145, 8, SS_NOPREFIX
    PUSHBUTTON "Driver &Details...", IDC_DRIVER_DETAILS, 7, 107, 70, 14
    LTEXT "To view details about the driver files.", -1, 87, 110, 158, 8
    PUSHBUTTON "&Update Driver...", IDC_UPDATE_DRIVER, 7, 135, 70, 14
    LTEXT "To update the driver for this device.", -1, 87, 138, 158, 8
    PUSHBUTTON "&Roll Back Driver", IDC_ROLLBACK, 7, 163, 70, 14
    LTEXT "If the device fails after updating the driver, roll back to the previously installed driver.", -1, 87, 162, 158, 16
    PUSHBUTTON "&Uninstall", IDC_UNINSTALL, 7, 191, 70, 14
    LTEXT "To uninstall the driver (Advanced).", -1, 87, 194, 158, 8
}

IDD_DETAILS DIALOG 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Details"
FONT 8, "MS Shell Dlg"
{
    ICON "", IDC_DEVICE_ICON, 7, 7, 20, 20
    LTEXT "", IDC_NAME, 37, 13, 208, 8, SS_NOPREFIX
    COMBOBOX IDC_PROPERTY, 7, 37, 238, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_VALUES, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS |
            WS_BORDER | WS_TABSTOP, 7, 56, 238, 155
}

IDD_RESOURCES DIALOG 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Resources"
FONT 8, "MS Shell Dlg"
{
    ICON "", IDC_DEVICE_ICON, 7, 7, 20, 20
    LTEXT "", IDC_NAME, 37, 13, 208, 8, SS_NOPREFIX
    LTEXT "&Resource settings:", -1, 7, 36, 100, 8
    CONTROL "", IDC_RESOURCE_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER |
            WS_BORDER | WS_TABSTOP, 7, 46, 238, 48
    LTEXT "&Setting based on:", IDC_BASED_ON_LABEL, 7, 106, 60, 8
    COMBOBOX IDC_BASED_ON, 69, 104, 176, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "U&se automatic settings", IDC_AUTOMATIC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 69, 134, 100, 10
    PUSHBUTTON "&Change Setting...", IDC_CHANGE_SETTING, 175, 132, 70, 14
    LTEXT "Conflicting device list:", -1, 7, 154, 100, 8
    EDITTEXT IDC_CONFLICTS, 7, 164, 238, 45, ES_MULTILINE | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
}

IDD_DRIVER_FILES DIALOG 0, 0, 225, 252
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Driver File Details"
FONT 8, "MS Shell Dlg"
{
    ICON "", IDC_DEVICE_ICON, 7, 7, 20, 20
    LTEXT "", IDC_NAME, 37, 13, 181, 8, SS_NOPREFIX
    LTEXT "&Driver files:", -1, 7, 35, 100, 8
    CONTROL "", IDC_FILES, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS |
            WS_BORDER | WS_TABSTOP, 7, 45, 211, 78
    LTEXT "Provider:", -1, 14, 135, 55, 8
    LTEXT "", IDC_FILE_PROVIDER, 75, 135, 143, 8, SS_NOPREFIX
    LTEXT "File version:", -1, 14, 151, 55, 8
    LTEXT "", IDC_FILE_VERSION, 75, 151, 143, 8, SS_NOPREFIX
    LTEXT "Copyright:", -1, 14, 167, 55, 8
    LTEXT "", IDC_FILE_COPYRIGHT, 75, 167, 143, 8, SS_NOPREFIX
    LTEXT "Digital Signer:", -1, 14, 183, 55, 8
    LTEXT "", IDC_FILE_SIGNER, 75, 183, 143, 16, SS_NOPREFIX
    DEFPUSHBUTTON "OK", IDOK, 168, 231, 50, 14
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* ReactOS art (devmgr, setupapi, mmsys, batt), and a toolbar strip from Wine's comctl32 and ReactOS devmgr art;
 * the genuine Windows XP resources come from the resource pack when it is installed */

/* @makedep: icons/devmgr.ico */
IDI_DEVMGR ICON icons/devmgr.ico
/* @makedep: icons/159.ico */
IDI_RESOURCES ICON icons/159.ico
