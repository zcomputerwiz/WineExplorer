#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDM_MAIN MENU
{
    POPUP "&File"
    {
        MENUITEM "&Options...", IDM_OPTIONS, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    }
    POPUP "&Action"
    {
        MENUITEM "Scan for hardware changes", IDM_SCAN
    }
    POPUP "&View"
    {
        MENUITEM "Devices by t&ype", IDM_BY_TYPE
        MENUITEM "Devices by co&nnection", IDM_BY_CONNECTION
        MENUITEM "Resources by ty&pe", IDM_RES_BY_TYPE
        MENUITEM "Resources by con&nection", IDM_RES_BY_CONNECTION
        MENUITEM SEPARATOR
        MENUITEM "Sho&w hidden devices", IDM_SHOW_HIDDEN
        MENUITEM SEPARATOR
        MENUITEM "C&ustomize...", IDM_CUSTOMIZE, GRAYED
    }
    POPUP "&Help"
    {
        MENUITEM "&Help Topics", IDM_HELP_TOPICS, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&About Device Manager", IDM_ABOUT
    }
}

IDM_MAIN ACCELERATORS
{
    VK_RETURN, IDM_PROPERTIES, VIRTKEY, ALT
    VK_F5, IDM_SCAN, VIRTKEY
}

