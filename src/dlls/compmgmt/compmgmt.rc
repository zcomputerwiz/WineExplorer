#include <windef.h>
#include <winuser.h>
#include <winnls.h>

#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDM_MAIN MENU
{
    POPUP "&Action"
    {
        MENUITEM "&Refresh", IDM_REFRESH
        MENUITEM "&Export List...", IDM_EXPORT, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "P&roperties", IDM_PROPERTIES, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Help", IDM_HELP_TOPICS, GRAYED
    }
    POPUP "&View"
    {
        MENUITEM "Lar&ge Icons", IDM_VIEW_LARGE
        MENUITEM "S&mall Icons", IDM_VIEW_SMALL
        MENUITEM "&List", IDM_VIEW_LIST
        MENUITEM "&Detail", IDM_VIEW_DETAIL
    }
    POPUP "&Help"
    {
        MENUITEM "&Help Topics", IDM_HELP_TOPICS, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&About Computer Management", IDM_ABOUT
    }
}

STRINGTABLE
{
    IDS_APPNAME "Computer Management"
    IDS_ROOT "Computer Management (Local)"
    IDS_COL_NAME "Name"
    IDS_COL_DESCRIPTION "Description"
    IDS_NO_DEVMGR "Device Manager could not be loaded."
    IDS_ABOUT_TEXT "Computer Management"
    IDS_NOT_AVAILABLE "Not available"

    IDS_NODE_BASE + 0 "Computer Management (Local)"
    IDS_NODE_BASE + 1 "System Tools"
    IDS_NODE_BASE + 2 "Event Viewer"
    IDS_NODE_BASE + 3 "Shared Folders"
    IDS_NODE_BASE + 4 "Local Users and Groups"
    IDS_NODE_BASE + 5 "Performance Logs and Alerts"
    IDS_NODE_BASE + 6 "Device Manager"
    IDS_NODE_BASE + 7 "Storage"
    IDS_NODE_BASE + 8 "Removable Storage"
    IDS_NODE_BASE + 9 "Disk Defragmenter"
    IDS_NODE_BASE + 10 "Disk Management"
    IDS_NODE_BASE + 11 "Services and Applications"
    IDS_NODE_BASE + 12 "Services"
    IDS_NODE_BASE + 13 "WMI Control"
    IDS_NODE_BASE + 14 "Indexing Service"

    IDS_DESC_BASE + 0 ""
    IDS_DESC_BASE + 1 ""
    IDS_DESC_BASE + 2 "View event logs"
    IDS_DESC_BASE + 3 "Manage shared folders"
    IDS_DESC_BASE + 4 "Manage local users and groups"
    IDS_DESC_BASE + 5 "Configure performance logs and alerts"
    IDS_DESC_BASE + 6 "Manage the devices of this computer"
    IDS_DESC_BASE + 7 ""
    IDS_DESC_BASE + 8 "Manage removable media"
    IDS_DESC_BASE + 9 "Defragment the disks"
    IDS_DESC_BASE + 10 "Manage disks and partitions"
    IDS_DESC_BASE + 11 ""
    IDS_DESC_BASE + 12 "Start, stop and configure services"
    IDS_DESC_BASE + 13 "Configure the WMI service"
    IDS_DESC_BASE + 14 "Manage the indexing of files"

    IDS_REASON_BASE + 2 "Event Viewer is not available yet. This system has no event log service."
    IDS_REASON_BASE + 3 "Shared Folders is not available. File sharing is handled by the host system."
    IDS_REASON_BASE + 4 "Local Users and Groups is not available yet. The accounts belong to the host system."
    IDS_REASON_BASE + 5 "Performance Logs and Alerts is not available. This system keeps no performance logs."
    IDS_REASON_BASE + 8 "Removable Storage is not available. The host system manages removable media."
    IDS_REASON_BASE + 9 "Disk Defragmenter is not available. The host system owns the file systems."
    IDS_REASON_BASE + 10 "Disk Management is not available. The disks and partitions belong to the host system's own tools."
    IDS_REASON_BASE + 12 "Services is not available yet."
    IDS_REASON_BASE + 13 "WMI Control is not available. WMI is not configurable on this system."
    IDS_REASON_BASE + 14 "The Indexing Service is not available yet."
}
