#include <windef.h>
#include <winuser.h>
#include <winnls.h>

#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDM_MAIN MENU
{
    POPUP "&Action"
    {
        MENUITEM "&Refresh", IDM_REFRESH
        MENUITEM "&Export List...", IDM_EXPORT, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "P&roperties", IDM_PROPERTIES, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Help", IDM_HELP_TOPICS, GRAYED
    }
    POPUP "&View"
    {
        MENUITEM "Lar&ge Icons", IDM_VIEW_LARGE
        MENUITEM "S&mall Icons", IDM_VIEW_SMALL
        MENUITEM "&List", IDM_VIEW_LIST
        MENUITEM "&Detail", IDM_VIEW_DETAIL
    }
    POPUP "&Help"
    {
        MENUITEM "&Help Topics", IDM_HELP_TOPICS, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&About Computer Management", IDM_ABOUT
    }
}

/* the Services properties pages (the sheet is made by services.c) */
IDD_SVC_GENERAL DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
{
    LTEXT        "Service &name:", -1, 10, 12, 62, 10
    EDITTEXT     IDC_SVC_NAME, 76, 10, 166, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT        "D&isplay name:", -1, 10, 30, 62, 10
    EDITTEXT     IDC_SVC_DISPLAY, 76, 28, 166, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT        "&Description:", -1, 10, 48, 62, 10
    EDITTEXT     IDC_SVC_DESCRIPTION, 76, 46, 166, 36, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT        "Pat&h to executable:", -1, 10, 90, 100, 10
    EDITTEXT     IDC_SVC_PATH, 10, 102, 232, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT        "Startup typ&e:", -1, 10, 124, 62, 10
    COMBOBOX     IDC_SVC_STARTUP, 76, 122, 100, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX     "", -1, 10, 142, 232, 1
    LTEXT        "Service status:", -1, 10, 152, 62, 10
    LTEXT        "", IDC_SVC_STATUS, 76, 152, 100, 10
    PUSHBUTTON   "&Start", IDC_SVC_START, 10, 170, 50, 14
    PUSHBUTTON   "S&top", IDC_SVC_STOP, 64, 170, 50, 14
    PUSHBUTTON   "&Pause", IDC_SVC_PAUSE, 118, 170, 50, 14
    PUSHBUTTON   "&Resume", IDC_SVC_RESUME, 172, 170, 50, 14
}

IDD_SVC_LOGON DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Log On"
FONT 8, "MS Shell Dlg"
{
    LTEXT        "Log on as:", -1, 10, 12, 100, 10
    LTEXT        "", IDC_SVC_ACCOUNT, 10, 26, 232, 10, SS_NOPREFIX
    LTEXT        "", IDC_SVC_NOTE, 10, 50, 232, 40
}

IDD_SVC_RECOVERY DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Recovery"
FONT 8, "MS Shell Dlg"
{
    LTEXT        "Select the computer's response if this service fails.", -1, 10, 10, 232, 10
    LTEXT        "&First failure:", -1, 10, 30, 80, 10
    COMBOBOX     IDC_REC_FIRST, 96, 28, 146, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT        "&Second failure:", -1, 10, 48, 80, 10
    COMBOBOX     IDC_REC_SECOND, 96, 46, 146, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT        "Subsequent failure&s:", -1, 10, 66, 80, 10
    COMBOBOX     IDC_REC_THIRD, 96, 64, 146, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT        "Reset fail &count after:", -1, 10, 92, 80, 10
    EDITTEXT     IDC_REC_RESET, 96, 90, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT        "days", -1, 142, 92, 60, 10
    LTEXT        "R&estart service after:", -1, 10, 110, 80, 10
    EDITTEXT     IDC_REC_DELAY, 96, 108, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT        "minutes", -1, 142, 110, 60, 10
    LTEXT        "", IDC_SVC_NOTE, 10, 136, 232, 40
}

IDD_SVC_DEPENDENCIES DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Dependencies"
FONT 8, "MS Shell Dlg"
{
    LTEXT        "This service depends on the following system components:", -1, 10, 10, 232, 10
    LISTBOX      IDC_SVC_DEPENDS_ON, 10, 22, 232, 70, LBS_NOSEL | WS_VSCROLL | WS_BORDER
    LTEXT        "The following system components depend on this service:", -1, 10, 104, 232, 10
    LISTBOX      IDC_SVC_DEPENDENTS, 10, 116, 232, 70, LBS_NOSEL | WS_VSCROLL | WS_BORDER
}

/* Local Users and Groups: the dialogs (users.c) */
IDD_USR_NEW DIALOGEX 0, 0, 220, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New User"
FONT 8, "MS Shell Dlg"
{
    LTEXT        "&User name:", -1, 10, 12, 70, 10
    EDITTEXT     IDC_USR_NAME, 84, 10, 126, 12, ES_AUTOHSCROLL
    LTEXT        "&Full name:", -1, 10, 30, 70, 10
    EDITTEXT     IDC_USR_FULLNAME, 84, 28, 126, 12, ES_AUTOHSCROLL
    LTEXT        "&Password:", -1, 10, 54, 70, 10
    EDITTEXT     IDC_USR_PW1, 84, 52, 126, 12, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT        "&Confirm password:", -1, 10, 72, 70, 10
    EDITTEXT     IDC_USR_PW2, 84, 70, 126, 12, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX "Account is &disabled", IDC_USR_DISABLED, 84, 94, 126, 10
    DEFPUSHBUTTON "C&reate", IDC_USR_CREATE, 100, 140, 50, 14
    PUSHBUTTON   "Cl&ose", IDCANCEL, 160, 140, 50, 14
}

IDD_USR_PASSWORD DIALOGEX 0, 0, 240, 150
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Set Password"
FONT 8, "MS Shell Dlg"
{
    LTEXT        "", IDC_USR_NOTE, 10, 8, 220, 60
    LTEXT        "&New password:", -1, 10, 78, 80, 10
    EDITTEXT     IDC_USR_PW1, 94, 76, 136, 12, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT        "&Confirm password:", -1, 10, 96, 80, 10
    EDITTEXT     IDC_USR_PW2, 94, 94, 136, 12, ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON "OK", IDOK, 120, 128, 50, 14
    PUSHBUTTON   "Cancel", IDCANCEL, 180, 128, 50, 14
}

IDD_USR_GENERAL DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
{
    LTEXT        "User name:", -1, 10, 14, 62, 10
    EDITTEXT     IDC_USR_NAME, 76, 12, 166, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT        "&Full name:", -1, 10, 32, 62, 10
    EDITTEXT     IDC_USR_FULLNAME, 76, 30, 166, 12, ES_AUTOHSCROLL
    AUTOCHECKBOX "Account is &disabled", IDC_USR_DISABLED, 76, 56, 166, 10
}

IDD_USR_MEMBEROF DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Member Of"
FONT 8, "MS Shell Dlg"
{
    LTEXT        "Member of:", -1, 10, 10, 232, 10
    LISTBOX      IDC_USR_GROUPS, 10, 22, 232, 120, WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON   "A&dd to Administrators", IDC_USR_ADD, 10, 150, 90, 14
    PUSHBUTTON   "&Remove", IDC_USR_REMOVE, 106, 150, 50, 14
}

IDD_GRP_PROPS DIALOGEX 0, 0, 240, 190
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Group Properties"
FONT 8, "MS Shell Dlg"
{
    LTEXT        "Group name:", -1, 10, 14, 62, 10
    EDITTEXT     IDC_USR_NAME, 76, 12, 154, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT        "Description:", -1, 10, 32, 62, 10
    EDITTEXT     IDC_USR_FULLNAME, 76, 30, 154, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT        "Members:", -1, 10, 54, 100, 10
    LISTBOX      IDC_USR_GROUPS, 10, 66, 220, 90, LBS_NOSEL | WS_VSCROLL | WS_BORDER
    DEFPUSHBUTTON "OK", IDOK, 180, 166, 50, 14
}

STRINGTABLE
{
    IDS_USR_COL_FULLNAME "Full Name"
    IDS_USR_ERROR "The operation could not be completed.\n\n%s"
    IDS_USR_DELETE_ASK "Each user account has a unique identity. If you delete the account %s, the files and settings of the account are not removed, but the account cannot be created again with the same identity.\n\nDo you want to delete the user account?"
    IDS_USR_DELETE_TITLE "Local Users and Groups"
    IDS_USR_PW_MISMATCH "The passwords are not the same. Type the same password in both boxes."
    IDS_USR_NAME_EMPTY "Type a user name."
    IDS_USR_UNAVAILABLE "The accounts of this computer cannot be shown.\n\n%s"
    IDS_USR_PROPS_TITLE "%s Properties"
    IDS_USR_PW_TITLE "Set Password for %s"
    IDS_USR_PW_WARN "Changing the password lets the user log on with the new one. Anything the user has protected with the old password, such as stored passwords, may not be reachable afterwards."
    IDS_ERR_EXISTS "The user account already exists."
    IDS_ERR_PWD_SHORT "The password is shorter than the computer requires."
    IDS_ERR_NOT_FOUND "The user name could not be found."
    IDS_ERR_LAST_ADMIN "The last administrator account cannot be removed or changed to a standard account."
    IDS_ERR_LOGGED_IN "The user is logged on. Log the user off and try again."
    IDS_ERR_UNREACHABLE "The accounts service of this computer does not answer."
}

