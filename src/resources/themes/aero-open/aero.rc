#define REACTOS_VERSION_DLL
#define REACTOS_STR_FILE_DESCRIPTION	"Aero Open Visual Style\0"
#define REACTOS_STR_INTERNAL_NAME	"AeroOpen\0"
#define REACTOS_STR_ORIGINAL_FILENAME	"Aero.msstyles\0"
#include <reactos/version.rc>

#include <windows.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

1 COLORNAMES					{L"NormalColor\0Aero\0\0"}
COMBO COMBODATA					{0x0002,0x0002, 0x0000, 0x0002, 0x0001, 0x0003,}
1 PACKTHEM_VERSION				{0x03,}
1 FILERESNAMES					{L"NORMALAERO_INI\0NORMALAERO_INI\0NORMALAERO_INI\0NORMALAERO_INI\0\0"}
1 SIZENAMES						{L"NormalSize\0Default\0\0"}
1 MINDEPTH						{0x000F,0x000F,0x0000,}

NORMALAERO_INI TEXTFILE			"textfiles/NormalAero_utf16.INI"
THEMES_INI TEXTFILE				{L"\r\n"}

