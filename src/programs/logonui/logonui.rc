#include <windef.h>
#include <winuser.h>
#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

STRINGTABLE
{
    IDS_TITLE "Windows Logon"
    IDS_BEGIN "To begin, click your user name"
    IDS_NO_GREETER "Windows logon must be started by the display manager."
    IDS_SESSION_FAILED "Windows could not start your session."
    IDS_TURNOFF "Turn off computer"
    IDS_ACCOUNTS_HINT "After you log on, you can add or change accounts.\nJust go to Control Panel and click User Accounts."
    IDS_TYPE_PASSWORD "Type your password"
    IDS_LOGGED_ON "Logged on"
    IDS_FORGOT_TITLE "Did you forget your password?"
    IDS_FORGOT_TEXT "Please type your password again.\nBe sure to use the correct uppercase and lowercase letters."
    IDS_LOADING "Loading your personal settings..."
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* open pictures (scripts/open_assets.py); magenta is transparent in the 24-bit ones */
/* @makedep: shine.bmp */
IDB_SHINE       BITMAP "shine.bmp"
/* @makedep: editframe.bmp */
IDB_EDITFRAME   BITMAP "editframe.bmp"
/* @makedep: go.bmp */
IDB_GO          BITMAP "go.bmp"
/* @makedep: go_hot.bmp */
IDB_GO_HOT      BITMAP "go_hot.bmp"
/* @makedep: help.bmp */
IDB_HELP        BITMAP "help.bmp"
/* @makedep: help_hot.bmp */
IDB_HELP_HOT    BITMAP "help_hot.bmp"
/* @makedep: turnoff.bmp */
IDB_TURNOFF     BITMAP "turnoff.bmp"
/* @makedep: turnoff_hot.bmp */
IDB_TURNOFF_HOT BITMAP "turnoff_hot.bmp"
/* @makedep: tile.bmp */
IDB_TILE        BITMAP "tile.bmp"
/* @makedep: frame.bmp */
IDB_FRAME       BITMAP "frame.bmp"
/* @makedep: frame_hot.bmp */
IDB_FRAME_HOT   BITMAP "frame_hot.bmp"
/* @makedep: user.bmp */
IDB_USER        BITMAP "user.bmp"
/* @makedep: logo.bmp */
IDB_LOGO        BITMAP "logo.bmp"
/* @makedep: divider.bmp */
IDB_DIVIDER     BITMAP "divider.bmp"
/* @makedep: topstrip.bmp */
IDB_TOPSTRIP    BITMAP "topstrip.bmp"
/* @makedep: bottomstrip.bmp */
IDB_BOTTOMSTRIP BITMAP "bottomstrip.bmp"
