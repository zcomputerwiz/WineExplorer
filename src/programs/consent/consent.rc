#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_CONSENT DIALOGEX 0, 0, 260, 178
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "User Account Control"
FONT 8, "Tahoma"
BEGIN
    CONTROL         "", IDC_UAC_BANNER, "Static", SS_OWNERDRAW, 0, 0, 260, 36
    LTEXT           "Program name:", -1, 14, 46, 56, 10
    LTEXT           "", IDC_UAC_PROGRAM, 74, 46, 174, 12, SS_LEFT | SS_NOPREFIX
    LTEXT           "Publisher:", -1, 14, 60, 56, 10
    LTEXT           "", IDC_UAC_PUBLISHER, 74, 60, 174, 12, SS_LEFT | SS_NOPREFIX
    LTEXT           "File origin:", -1, 14, 74, 56, 10
    LTEXT           "", IDC_UAC_ORIGIN, 74, 74, 174, 10, SS_LEFT | SS_NOPREFIX
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 12, 90, 236, 1
    PUSHBUTTON      "&Details", IDC_UAC_DETAILS_BTN, 14, 98, 46, 14
    EDITTEXT        IDC_UAC_DETAILS_TEXT, 14, 116, 232, 42, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_VISIBLE
    PUSHBUTTON      "&Continue", IDYES, 144, 160, 50, 14
    DEFPUSHBUTTON   "&Cancel", IDNO, 198, 160, 50, 14
END

IDD_CREDENTIALS DIALOGEX 0, 0, 260, 215
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "User Account Control"
FONT 8, "Tahoma"
BEGIN
    CONTROL         "", IDC_UAC_BANNER, "Static", SS_OWNERDRAW, 0, 0, 260, 36
    LTEXT           "Program name:", -1, 14, 42, 56, 10
    LTEXT           "", IDC_UAC_PROGRAM, 74, 42, 174, 12, SS_LEFT | SS_NOPREFIX
    LTEXT           "Publisher:", -1, 14, 56, 56, 10
    LTEXT           "", IDC_UAC_PUBLISHER, 74, 56, 174, 12, SS_LEFT | SS_NOPREFIX
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 12, 70, 236, 1
    LTEXT           "The administrator account's rights apply inside this Wine prefix only, with no host or root access. The requesting user's host account and files are unchanged.", IDC_UAC_EXPLANATION, 14, 76, 232, 28
    LTEXT           "", IDC_UAC_DESKTOP_WARN, 14, 106, 232, 10, SS_LEFT
    LTEXT           "User name:", -1, 14, 120, 56, 10
    EDITTEXT        IDC_UAC_ACCOUNT, 74, 118, 172, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Password:", IDC_UAC_PW_LABEL, 14, 138, 56, 10
    EDITTEXT        IDC_UAC_PASSWORD, 74, 136, 172, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "", IDC_UAC_ERROR, 14, 156, 232, 18, SS_LEFT
    DEFPUSHBUTTON   "&Yes", IDYES, 144, 188, 50, 14, WS_TABSTOP
    PUSHBUTTON      "&No", IDNO, 198, 188, 50, 14, WS_TABSTOP
END
