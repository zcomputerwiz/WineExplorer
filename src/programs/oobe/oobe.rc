#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_OOBE_WELCOME DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Welcome to Debian GNU/Linux with WineExplorer"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Welcome to Debian GNU/Linux with WineExplorer", IDC_STATIC, 15, 10, 287, 16
    LTEXT "Thank you for installing Debian GNU/Linux with WineExplorer.", IDC_STATIC, 15, 35, 287, 14
    LTEXT "Let's spend a few minutes setting up your computer.", IDC_STATIC, 15, 55, 287, 14
    LTEXT "To continue, click Next.", IDC_STATIC, 15, 110, 287, 12
END

IDD_OOBE_UPDATES DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Help protect your PC"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Help protect your PC with Automatic Updates", IDC_STATIC, 15, 7, 287, 14
    LTEXT "Debian can routinely check for the latest important updates for your computer and install them automatically. These updates can include security updates, critical updates, and service packs.", IDC_STATIC, 15, 25, 287, 30
    AUTORADIOBUTTON "&Help protect my PC by turning on Automatic Updates now (recommended)", IDC_RADIO_UPDATES_ON, 15, 62, 287, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "N&ot right now", IDC_RADIO_UPDATES_OFF, 15, 80, 287, 10
    LTEXT "If you haven't turned on Automatic Updates, your computer might be vulnerable to security threats.", IDC_STATIC, 27, 95, 275, 20
END

IDD_OOBE_CONNECTIVITY DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Checking your Internet connectivity"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Checking your Internet connectivity", IDC_STATIC, 15, 7, 287, 14
    LTEXT "Please wait while Setup checks if your computer is connected to the Internet.", IDC_STATIC, 15, 28, 287, 18
    LTEXT "Network connection is active and configured.", IDC_NET_STATUS, 15, 60, 287, 20
END

IDD_OOBE_COMPONENTS DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Optional Windows Components"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Optional Windows Compatibility Components", IDC_STATIC, 15, 6, 287, 11
    LTEXT "You can choose optional compatibility components to download and install. These are not required to complete setup or use the desktop. Open replacement fonts and Wine's builtin DirectX compiler remain the defaults.", IDC_STATIC, 15, 18, 287, 24
    CONTROL "", IDC_COMP_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 15, 44, 210, 60
    PUSHBUTTON "&Review terms...", IDC_BTN_TERMS, 230, 44, 72, 14, WS_TABSTOP
    LTEXT "", IDC_COMP_SIZE, 230, 62, 72, 10
    LTEXT "", IDC_COMP_DESC, 15, 106, 287, 22
    LTEXT "", IDC_COMP_STATUS, 15, 130, 287, 10
END

IDD_OOBE_USERS DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Who will use this computer?"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Who will use this computer?", IDC_STATIC, 15, 7, 287, 14
    LTEXT "Type the name of each person who will use this computer. A user account will be created for each person, and the first user will have administrative privileges.", IDC_STATIC, 15, 22, 287, 24
    LTEXT "&Your name:", IDC_STATIC, 15, 52, 60, 8
    EDITTEXT IDC_USER1, 85, 50, 150, 14, WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL
    LTEXT "2nd User:", IDC_STATIC, 15, 69, 60, 8
    EDITTEXT IDC_USER2, 85, 67, 150, 14, WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL
    LTEXT "3rd User:", IDC_STATIC, 15, 86, 60, 8
    EDITTEXT IDC_USER3, 85, 84, 150, 14, WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL
    LTEXT "4th User:", IDC_STATIC, 15, 103, 60, 8
    EDITTEXT IDC_USER4, 85, 101, 150, 14, WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL
    LTEXT "5th User:", IDC_STATIC, 15, 120, 60, 8
    EDITTEXT IDC_USER5, 85, 118, 150, 14, WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL
END

IDD_OOBE_PASSWORD DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Set a password"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Set a password for your user account", IDC_STATIC, 15, 7, 287, 14
    LTEXT "You can set a password to protect your account. If you leave the password empty, your account will have no password.", IDC_STATIC, 15, 24, 287, 20
    LTEXT "User account:", IDC_PASS_USER_LABEL, 15, 52, 287, 10
    LTEXT "&Password:", IDC_STATIC, 15, 70, 70, 8
    EDITTEXT IDC_PASS_EDIT1, 90, 68, 140, 14, WS_VISIBLE | WS_TABSTOP | ES_PASSWORD
    LTEXT "&Confirm:", IDC_STATIC, 15, 90, 70, 8
    EDITTEXT IDC_PASS_EDIT2, 90, 88, 140, 14, WS_VISIBLE | WS_TABSTOP | ES_PASSWORD
END

IDD_OOBE_FINISH DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Thank you!"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Thank you!", IDC_STATIC, 15, 7, 287, 12
    LTEXT "Congratulations, you are ready to go!", IDC_STATIC, 15, 20, 287, 10
    LTEXT "Debian GNU/Linux with WineExplorer is now fully configured.", IDC_STATIC, 15, 32, 287, 10
    LTEXT "", IDC_FINISH_SUMMARY, 15, 46, 287, 50
    LTEXT "You can install or manage optional components anytime from Start Menu -> Administrative Tools -> Windows Components.", IDC_STATIC, 15, 100, 287, 18
    LTEXT "To finish Setup and begin using your computer, click Finish.", IDC_STATIC, 15, 122, 287, 14
END

IDD_OOBE_TERMS DIALOGEX 0, 0, 300, 200
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vendor License Agreement"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Please review the license terms from the official vendor:", IDC_STATIC, 10, 8, 280, 10
    EDITTEXT IDC_TERMS_TEXT, 10, 20, 280, 134, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX "I &accept the terms of this license agreement", IDC_TERMS_AGREE, 10, 158, 280, 12, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 185, 178, 50, 14, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 240, 178, 50, 14, WS_TABSTOP
END

/* Review-only embedded terms (e.g. CoreFonts). The accept checkbox is hidden for
 * review-only components: closing this dialog never selects the component for
 * install or records any acceptance. */
IDD_OOBE_REVIEW DIALOGEX 0, 0, 300, 240
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Review Embedded License Terms"
FONT 8, "MS Shell Dlg"
BEGIN
    /* F3: the information and status lines are wrapping/scrollable read-only edit
     * controls, not plain statics. A static LTEXT does not word-wrap, so the longer
     * Q5 information/cancellation strings clipped at their fixed height; a multiline
     * edit wraps them to the control width and scrolls if they ever exceed it, so no
     * text is lost at any DPI or font substitution. They carry no WS_TABSTOP because
     * they are informational, not interactive. */
    EDITTEXT IDC_REV_INFO, 10, 8, 280, 72, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_BORDER
    EDITTEXT IDC_REV_TERMS, 10, 84, 280, 88, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    EDITTEXT IDC_REV_STATUS, 10, 176, 280, 24, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_BORDER
    AUTOCHECKBOX "I &accept the terms of this license agreement", IDC_REV_AGREE, 10, 202, 200, 12, WS_TABSTOP
    PUSHBUTTON "&Download packages to review", IDC_BTN_REV_DOWNLOAD, 10, 220, 130, 14, WS_TABSTOP
    PUSHBUTTON "Stop", IDC_BTN_REV_CANCEL, 145, 220, 38, 14, WS_TABSTOP
    DEFPUSHBUTTON "Close", IDOK, 188, 220, 48, 14, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 241, 220, 49, 14, WS_TABSTOP
END
