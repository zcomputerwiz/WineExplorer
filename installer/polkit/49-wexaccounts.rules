//
// WineExplorer: what polkit allows the accounts helper wex-accountsd (docs/LOCAL_USERS_DESIGN.md, B1 and U4). The helper
// runs as the system account wexaccounts and is the only process of the machine that may administer user accounts through
// AccountsService and start the account map's sync unit and the blank-password reconcile unit (docs/BLANK_PASSWORDS.md: it
// takes no argument and only makes the group nopasswdlogin equal the accounts with an empty password). Nothing else is
// granted to that account, and no rule here names any other user or a group that a user can join. Installed in
// /etc/polkit-1/rules.d/ (as 49-wexsetup.rules is).
polkit.addRule(function(action, subject) {
    if (subject.user != "wexaccounts")
        return;
    if (action.id == "org.freedesktop.accounts.user-administration")
        return polkit.Result.YES;
    if (action.id == "org.freedesktop.systemd1.manage-units" && action.lookup("verb") == "start" &&
        (action.lookup("unit") == "wex-accounts-sync.service" || action.lookup("unit") == "wex-accounts-blank.service"))
        return polkit.Result.YES;
});
