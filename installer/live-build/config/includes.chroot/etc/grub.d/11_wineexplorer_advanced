#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# GRUB menu entry for WineExplorer's Advanced Options menu (docs/SAFE_MODE.md): the latest kernel with
# wexmode=menu. Its hotkey is F8: during GRUB's hidden timeout a menu hotkey boots its entry at once
# (grub-core/normal/menu.c), so F8 at start opens the menu, as on Windows XP. Replaced by a Vintner Boot variant
# once Vintner is the loader (docs/VINTNER_BOOT.md section 4.3).
set -e

prefix="/usr"
exec_prefix="/usr"
datarootdir="/usr/share"

. "$pkgdatadir/grub-mkconfig_lib"

export TEXTDOMAIN=grub
export TEXTDOMAINDIR="${datarootdir}/locale"

CLASS="--class wineexplorer --class debian --class gnu-linux --class gnu --class os"

# The newest kernel in /boot, as 10_linux puts first
list=""
for i in /boot/vmlinuz-* /vmlinuz-* /boot/kernel-* ; do
    if grub_file_is_not_garbage "$i" ; then list="$list $i" ; fi
done
latest_kernel=$(echo $list | tr ' ' '\n' | version_sort -r | head -n 1)
if [ -z "$latest_kernel" ]; then
    exit 0
fi

version=$(echo "$latest_kernel" | sed -e "s,^.*/vmlinuz-,,;s,^.*/kernel-,,")
dirname=$(dirname "$latest_kernel")
basename=$(basename "$latest_kernel")
rel_dirname=$(make_system_path_relative_to_its_root "$dirname")

initrd=""
for i in "initrd.img-${version}" "initrd-${version}.img" "initrd-${version}.gz" "initrd-${version}" ; do
    if test -e "${dirname}/${i}" ; then
        initrd="$i"
        break
    fi
done

if [ -z "$boot_device_id" ]; then
    boot_device_id="$(grub_get_device_id "${GRUB_DEVICE}")"
fi

if [ "x${GRUB_DEVICE_UUID}" = "x" ] || [ "x${GRUB_DISABLE_LINUX_UUID}" = "xtrue" ] \
    || ! test -e "/dev/disk/by-uuid/${GRUB_DEVICE_UUID}" \
    || ( test -e "${GRUB_DEVICE}" && uses_abstraction "${GRUB_DEVICE}" lvm ); then
    root_device="${GRUB_DEVICE}"
else
    root_device="UUID=${GRUB_DEVICE_UUID}"
fi

title="Advanced Options for WineExplorer (F8)"

echo "menuentry '$(echo "$title" | grub_quote)' ${CLASS} --hotkey=f8 \$menuentry_id_option 'wex-advanced-$boot_device_id' {"
if [ "x$GRUB_GFXPAYLOAD_LINUX" = x ] || [ "x$GRUB_GFXPAYLOAD_LINUX" != xtext ]; then
    echo "	load_video"
fi
echo "	insmod gzio"
if [ x$dirname = x/ ]; then
    prepare_grub_to_access_device ${GRUB_DEVICE} | grub_add_tab
else
    prepare_grub_to_access_device ${GRUB_DEVICE_BOOT} | grub_add_tab
fi
echo "	linux	${rel_dirname}/${basename} root=${root_device} ro ${GRUB_CMDLINE_LINUX} ${GRUB_CMDLINE_LINUX_DEFAULT} wexmode=menu"
if test -n "$initrd"; then
    echo "	initrd	${rel_dirname}/${initrd}"
fi
echo "}"
