#!/bin/sh
set -e
# Scan the immutable payload, not the build chroot (binary-stage tools/cache
# directories can be added to that chroot after squashfs has been created).
mkdir -p setup
test -f ../config/mklayout.py
test -f ../config/txtsetup.sif.in
test -f live/filesystem.squashfs
SOURCE_ROOT=$(mktemp -d /var/tmp/wex-layout.XXXXXX)
MOUNTED=false
cleanup() {
    if $MOUNTED; then umount "$SOURCE_ROOT"; fi
    rmdir "$SOURCE_ROOT"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
mount -t squashfs -o ro,loop live/filesystem.squashfs "$SOURCE_ROOT"
MOUNTED=true
python3 ../config/mklayout.py "$SOURCE_ROOT" setup ../config/txtsetup.sif.in

# Copy eula.txt if available
if [ -f "$SOURCE_ROOT/setup/eula.txt" ]; then
    cp -f "$SOURCE_ROOT/setup/eula.txt" setup/eula.txt
fi

# Copy unattend.sif if present (unattended mode)
if [ -f ../config/includes.chroot/setup/unattend.sif ]; then
    cp -f ../config/includes.chroot/setup/unattend.sif setup/unattend.sif || true
else
    rm -f setup/unattend.sif
fi
