#!/bin/sh
set -e

# Ensure display-manager is enabled and linked to LightDM
mkdir -p /etc/systemd/system/graphical.target.wants
ln -sf /usr/lib/systemd/system/lightdm.service /etc/systemd/system/display-manager.service
echo /usr/sbin/lightdm > /etc/X11/default-display-manager
ln -sf /etc/systemd/system/display-manager.service /etc/systemd/system/graphical.target.wants/display-manager.service

# Prevent display-manager and LightDM from starting during text-mode setup
mkdir -p /etc/systemd/system/display-manager.service.d /etc/systemd/system/lightdm.service.d
cat > /etc/systemd/system/display-manager.service.d/override.conf << 'EOF'
[Unit]
ConditionKernelCommandLine=!wexsetup=textmode
ConditionPathExists=!/etc/wineexplorer/setup/stage
EOF
cp -f /etc/systemd/system/display-manager.service.d/override.conf /etc/systemd/system/lightdm.service.d/override.conf

# Ensure wex-textsetup, wex-setup, and wex-oobe are enabled in multi-user.target
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /usr/lib/systemd/system/wex-textsetup.service /etc/systemd/system/multi-user.target.wants/wex-textsetup.service
ln -sf /usr/lib/systemd/system/wex-setup.service /etc/systemd/system/multi-user.target.wants/wex-setup.service
ln -sf /usr/lib/systemd/system/wex-oobe.service /etc/systemd/system/multi-user.target.wants/wex-oobe.service

# Fix permissions on desktop file
if [ -f /usr/share/xsessions/wine-explorer.desktop ]; then
    chmod 644 /usr/share/xsessions/wine-explorer.desktop
fi

# Ensure standard permissions on system directories and libraries
chmod 755 / /etc /usr /var /setup /home 2>/dev/null || true
chmod 755 /usr/lib /usr/lib64 /usr/local /usr/local/lib /usr/local/bin /usr/bin /usr/sbin 2>/dev/null || true
chmod -R a+rX /usr/lib /usr/local /usr/share 2>/dev/null || true
chmod 755 /etc/wineexplorer 2>/dev/null || true
chmod 1777 /tmp /var/tmp 2>/dev/null || true

# Explicitly ensure setuid bits are preserved on elevation binaries
chmod 4755 /usr/bin/sudo /usr/bin/su /usr/bin/pkexec /usr/bin/passwd /usr/bin/gpasswd /usr/bin/newgrp /usr/bin/chsh /usr/bin/chfn 2>/dev/null || true
chmod 4755 /usr/lib/dbus-1/dbus-daemon-launch-helper 2>/dev/null || true
chmod 4755 /usr/lib/polkit-1/polkit-agent-helper-1 2>/dev/null || true
# Ensure setup executables and scripts are executable
chmod 755 /setup/textsetup /usr/local/bin/wex-*.sh /usr/local/bin/*.exe 2>/dev/null || true

# Ensure sudoers.d files have 0440 mode
chmod 440 /etc/sudoers.d/* 2>/dev/null || true

# Mask plymouth waiting services so they do not block headless or non-graphical boot
systemctl mask plymouth-quit-wait.service plymouth-start.service plymouth.service 2>/dev/null || true
