; Unattended installation answer file for WineExplorer
[Data]
AutomaticUpdates = Yes

[Unattended]
UnattendMode = FullUnattended
OemSkipEula = Yes
AutomaticUpdates = Yes
; TargetDisk = /dev/sda      (default: the first disk; Setup stops if the named disk is missing)
Repartition = Yes

[GuiUnattended]
TimeZone = "UTC"
AdminPassword = ""
OEMSkipRegional = 1

[UserData]
FullName = "Administrator"
OrgName = "WineExplorer Organization"
ComputerName = "WEX-PC"

[Networking]
InstallDefaultComponents = Yes

[Components]
libreoffice = Off
firefox = On
samba = Off

[WexOobe]
User1 = "wineuser"
User1Admin = 1
