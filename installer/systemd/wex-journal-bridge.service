# Selected systemd journal entries to the Event Log and the Event Log's records to the journal
# (docs/EVENTLOG_JOURNAL.md). Its own account, in systemd-journal only: session 0 never reads the journal.
[Unit]
Description=WineExplorer journal bridge (systemd journal and Event Log)
Documentation=https://github.com/zcomputerwiz/WineExplorer/blob/master/docs/EVENTLOG_JOURNAL.md
Requires=wex-journal-bridge.socket
After=wex-journal-bridge.socket

[Service]
Type=simple
User=wexjournal
Group=wexjournal
SupplementaryGroups=systemd-journal
ExecStart=/usr/local/libexec/wineexplorer/wex-journal-bridge
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
MemoryMax=256M
