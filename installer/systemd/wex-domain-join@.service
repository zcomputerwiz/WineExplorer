#
# WineExplorer: one request of the domain join engine (docs/DOMAIN_JOIN.md), started by wex-domain-join.socket for each
# connection: the request is on standard input, the answer goes to standard output. A join takes up to a minute or two
# (the controller, the account, winbind), hence the long time out. Root: the engine writes smb.conf, krb5.conf,
# nsswitch.conf and PAM, and joins.
#
# The times fit together: the engine waits 5 seconds for another request's lock (then ERROR_BUSY), runs at most
# RuntimeMaxSec, and when stopped it has TimeoutStopSec to put a rename back and answer. The caller (wexjoin's unix
# side) waits WEX_JOIN_WAIT_SECONDS (wexjoin.h, 420), more than the two together, so that it never reports a time out
# for a request that then succeeds.

[Unit]
Description=WineExplorer domain join (one request)

[Service]
ExecStart=/usr/local/sbin/wex-domain-join.sh serve
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=300
TimeoutStopSec=90
# the engine is the one place that changes the machine's authentication: nothing else of the system is its business
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
