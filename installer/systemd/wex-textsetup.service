[Unit]
Description=WineExplorer Text-mode Setup
ConditionKernelCommandLine=wexsetup=textmode
DefaultDependencies=no
After=systemd-udev-settle.service local-fs.target plymouth-quit.service plymouth-read-write.service
Before=getty@tty1.service display-manager.service
Conflicts=getty@tty1.service display-manager.service plymouth-start.service plymouth.service

[Service]
Type=simple
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=TERM=linux
Environment=LANG=C.UTF-8
ExecStart=/setup/textsetup

[Install]
WantedBy=multi-user.target
