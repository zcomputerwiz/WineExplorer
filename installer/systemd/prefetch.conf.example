# SPDX-License-Identifier: GPL-2.0-or-later
# Example configuration for wexprefetchd.
#
# Copy this file to /etc/wineexplorer/prefetch.conf and adjust the values.
# The daemon reads these keys at startup; the values below are the defaults.

# Enable (1) or disable (0) the prefetch service.
Enabled=1

# Maximum total cache size in megabytes.
MaxCacheMB=8192

# Maximum number of concurrent requests the daemon will serve.
MaxConcurrent=128

# Maximum size of a single cached image in megabytes.
MaxImageMB=1024

# Maximum number of cache entries. Images are sparse, so each entry is also charged 4 KiB against MaxCacheMB.
MaxEntries=4096

# Per user limit on reading and hashing files the service has not seen before, per minute (0 = unlimited).
# Files already known are free. A request over the limit is answered BUSY and the client loads the image itself.
MaxBuildsPerMinute=120

# Refuse sources on FUSE, NFS, SMB and 9p filesystems (1, the default): reading them can block forever while the
# service holds its build lock. Set to 0 only for testing, for example when images live on a WSL drive mount.
RejectNetworkFS=1
