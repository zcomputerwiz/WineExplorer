#
# WineExplorer: the accounts helper (docs/LOCAL_USERS_DESIGN.md), started by wex-accountsd.socket. A native program of its
# own account, wexaccounts: no supplementary groups (above all not the system group), no capabilities, no network. It makes
# the AccountsService and sync-unit D-Bus calls for session 0's wineserver and nobody else; polkit names only this account
# (installer/polkit/49-wexaccounts.rules). It leaves when idle; the socket starts it again.

[Unit]
Description=WineExplorer accounts helper
Requires=wex-accountsd.socket
After=wex-accountsd.socket dbus.socket accounts-daemon.service
ConditionPathExists=/etc/wineexplorer/accountsd.conf

[Service]
Type=simple
User=wexaccounts
Group=wexaccounts
SupplementaryGroups=
ExecStart=/usr/local/libexec/wineexplorer/wex-accountsd
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
LimitCORE=0
# it reads /proc/<pid> of the server and talks to the system bus: both stay reachable
