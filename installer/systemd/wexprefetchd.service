# SPDX-License-Identifier: GPL-2.0-or-later
[Unit]
Description=WineExplorer PE image cache and prefetch service
Documentation=https://github.com/zcomputerwiz/WineExplorer/blob/master/docs/PREFETCH_SERVICE.md
Requires=wexprefetchd.socket
After=wexprefetchd.socket

[Service]
Type=simple
User=wexcache
Group=wexcache
ExecStart=/usr/local/sbin/wexprefetchd
CacheDirectory=wineexplorer/images wineexplorer/prefetch
CacheDirectoryMode=0755
# /run/wineexplorer stays root's (tmpfiles, or the .socket unit's DirectoryMode=0755): the daemon only receives its
# socket from systemd, and Wine trusts the boot mode file there (docs/SAFE_MODE_WORKORDER.md B0, B1).
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0022
ReadWritePaths=/var/cache/wineexplorer
MemoryMax=2G
