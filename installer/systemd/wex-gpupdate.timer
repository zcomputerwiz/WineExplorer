#
# WineExplorer: domain Group Policy for Windows programs, at start and then in the background at the interval of
# Windows (90 minutes plus up to 30 at random, set by the policy "Set Group Policy refresh interval for computers";
# docs/GROUP_POLICY.md, "The refresh interval"). The first run is wex-gpupdate.service's, two minutes after start; the
# timer then ticks every 5 minutes and wex-gpupdate.sh --background decides whether a refresh is due. Enabled together
# with session 0 (setup-machine-root.sh with WEX_SESSION0=1).

[Unit]
Description=WineExplorer domain Group Policy refresh (timer)

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Unit=wex-gpupdate-background.service

[Install]
WantedBy=timers.target
