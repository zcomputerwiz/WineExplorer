[Unit]
Description=WineExplorer Safe Mode Setup
DefaultDependencies=no
After=local-fs.target
Before=display-manager.service lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/wex-safemode-setup.sh start
ExecStop=/usr/local/sbin/wex-safemode-setup.sh stop

[Install]
WantedBy=display-manager.service multi-user.target
