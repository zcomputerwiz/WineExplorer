# The Advanced Options menu (XP's F8 menu) on tty1, before basic.target: no timer, socket or service of the
# normal boot has started yet (docs/SAFE_MODE.md). If the menu fails, the normal boot continues.
[Unit]
Description=Advanced Options Menu
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target systemd-vconsole-setup.service
Conflicts=shutdown.target
Before=shutdown.target
OnFailure=graphical.target

[Service]
Type=oneshot
# plymouthd from the initramfs still holds the screen and reads tty1 (its quit units are masked): the menu quits
# it first, asking until it is gone (quit_plymouth), since one `plymouth quit` here did not always take
ExecStart=/usr/local/sbin/wex-advanced-options
Environment=TERM=linux
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
