+/* What a message holds, for the debug log: the keys and the values of a ValueSet. */
+static void dump_message( const char *what, IPropertySet *message )
+{
+    IIterable_IKeyValuePair_HSTRING_IInspectable *iterable;
+    IIterator_IKeyValuePair_HSTRING_IInspectable *iterator;
+    BOOLEAN has;
+
+    if (!TRACE_ON(model)) return;
+    if (!message) { TRACE( "%s: no message\n", what ); return; }
+    if (FAILED(IPropertySet_QueryInterface( message, &IID_IIterable_IKeyValuePair_HSTRING_IInspectable, (void **)&iterable )))
+        return;
+    if (SUCCEEDED(IIterable_IKeyValuePair_HSTRING_IInspectable_First( iterable, &iterator )))
+    {
+        TRACE( "%s:\n", what );
+        while (SUCCEEDED(IIterator_IKeyValuePair_HSTRING_IInspectable_get_HasCurrent( iterator, &has )) && has)
+        {
+            IKeyValuePair_HSTRING_IInspectable *pair;
+            HSTRING key = NULL, text = NULL;
+            IInspectable *value = NULL;
+            IPropertyValue *property;
+            PropertyType type = 0;
+
+            if (SUCCEEDED(IIterator_IKeyValuePair_HSTRING_IInspectable_get_Current( iterator, &pair )))
+            {
+                IKeyValuePair_HSTRING_IInspectable_get_Key( pair, &key );
+                IKeyValuePair_HSTRING_IInspectable_get_Value( pair, &value );
+                if (value && SUCCEEDED(IInspectable_QueryInterface( value, &IID_IPropertyValue, (void **)&property )))
+                {
+                    IPropertyValue_get_Type( property, &type );
+                    if (type == PropertyType_String) IPropertyValue_GetString( property, &text );
+                    TRACE( "  %s = type %d %s\n", debugstr_hstring( key ), type, text ? debugstr_hstring( text ) : "" );
+                    WindowsDeleteString( text );
+                    IPropertyValue_Release( property );
+                }
+                else TRACE( "  %s = %p\n", debugstr_hstring( key ), value );
+                if (value) IInspectable_Release( value );
+                WindowsDeleteString( key );
+                IKeyValuePair_HSTRING_IInspectable_Release( pair );
+            }
+            if (FAILED(IIterator_IKeyValuePair_HSTRING_IInspectable_MoveNext( iterator, &has ))) break;
+        }
+        IIterator_IKeyValuePair_HSTRING_IInspectable_Release( iterator );
+    }
+    IIterable_IKeyValuePair_HSTRING_IInspectable_Release( iterable );
+}
+
+static IPropertySet *new_value_set(void)
+{
+    HSTRING name;
+    IInspectable *object;
+    IPropertySet *set = NULL;
+
+    if (FAILED(WindowsCreateString( L"Windows.Foundation.Collections.ValueSet",
+                                    ARRAY_SIZE(L"Windows.Foundation.Collections.ValueSet") - 1, &name ))) return NULL;
+    if (SUCCEEDED(RoActivateInstance( name, &object )))
+    {
+        IInspectable_QueryInterface( object, &IID_IPropertySet, (void **)&set );
+        IInspectable_Release( object );
+    }
+    WindowsDeleteString( name );
+    return set;
+}
