+static HRESULT WINAPI request_get_Message( IAppServiceRequest *iface, IPropertySet **value )
+{
+    struct request *impl = impl_from_IAppServiceRequest( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if ((*value = impl->message)) IPropertySet_AddRef( *value );
+    return S_OK;
+}
