+static BOOL probe_enabled(void)
+{
+    return GetEnvironmentVariableW( L"WINEAPPSERVICE_HELLO", NULL, 0 ) != 0;
+}
+
+static DWORD CALLBACK hello_thread( void *param )
+{
+    IAppServiceConnection *iface = param;
+    struct connection *impl = impl_from_IAppServiceConnection( iface );
+    IAppServiceRequestReceivedEventArgs *args;
+    IPropertySet *message;
+
+    Sleep( 1500 );
+    TRACE( "probe: sending the first request, handler %p.\n", impl->request_handler );
+    if (impl->request_handler && (message = new_value_set()))
+    {
+        if (SUCCEEDED(received_args_create( message, &args )))
+        {
+            ITypedEventHandler_AppServiceConnection_AppServiceRequestReceivedEventArgs_Invoke( impl->request_handler, iface, args );
+            IAppServiceRequestReceivedEventArgs_Release( args );
+        }
+        IPropertySet_Release( message );
+    }
+    IAppServiceConnection_Release( iface );
+    return 0;
+}
+
 static HRESULT WINAPI connection_OpenAsync( IAppServiceConnection *iface, IAsyncOperation_AppServiceConnectionStatus **operation )
 {
     TRACE( "iface %p, operation %p.\n", iface, operation );
+    if (probe_enabled())
+    {
+        HANDLE thread;
+
+        IAppServiceConnection_AddRef( iface );
+        if ((thread = CreateThread( NULL, 0, hello_thread, iface, 0, NULL ))) CloseHandle( thread );
+        else IAppServiceConnection_Release( iface );
+        return status_operation_create( AppServiceConnectionStatus_Success, operation );
+    }
     /* no provider is hosted: the service is not available (the name and the family are not even looked at) */
     return status_operation_create( AppServiceConnectionStatus_AppServiceUnavailable, operation );
 }
