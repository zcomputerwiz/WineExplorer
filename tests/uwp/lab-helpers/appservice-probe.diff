+static HRESULT received_args_create( IPropertySet *message, IAppServiceRequestReceivedEventArgs **out )
+{
+    struct received_args *args;
+    struct request *request;
+
+    if (!(args = calloc( 1, sizeof(*args) ))) return E_OUTOFMEMORY;
+    if (!(request = calloc( 1, sizeof(*request) )))
+    {
+        free( args );
+        return E_OUTOFMEMORY;
+    }
+    request->IAppServiceRequest_iface.lpVtbl = &request_vtbl;
+    request->ref = 1;
+    if ((request->message = message)) IPropertySet_AddRef( message );
+    args->IAppServiceRequestReceivedEventArgs_iface.lpVtbl = &received_args_vtbl;
+    args->ref = 1;
+    args->request = &request->IAppServiceRequest_iface;
+    *out = &args->IAppServiceRequestReceivedEventArgs_iface;
+    return S_OK;
+}
