+/* debugging aid (WINEAPPSERVICE_STACK=seconds): after that time, print the code addresses on the stack of the thread that
+ * made the first connection, as module+offset, to find what a program without symbols waits for */
+#ifndef __x86_64__
+static DWORD CALLBACK stack_thread( void *param ) { return 0; }
+#else
+static DWORD CALLBACK stack_thread( void *param )
+{
+    HANDLE main_thread = param;
+    DWORD tid = GetThreadId( main_thread );
+    WCHAR text[16];
+    DWORD seconds = 20;
+    HANDLE thread;
+    CONTEXT context = { 0 };
+
+    if (GetEnvironmentVariableW( L"WINEAPPSERVICE_STACK", text, ARRAY_SIZE(text) )) seconds = wcstoul( text, NULL, 10 );
+    Sleep( seconds * 1000 );
+    thread = main_thread;
+    if (SuspendThread( thread ) != (DWORD)-1)
+    {
+        context.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+        if (GetThreadContext( thread, &context ))
+        {
+            ULONG_PTR *stack = (ULONG_PTR *)context.Rsp;
+            MEMORY_BASIC_INFORMATION info;
+            SIZE_T i, count = 16384;
+            int shown = 0;
+
+            ERR( "stack of thread %04lx: rip %p rsp %p\n", tid, (void *)context.Rip, stack );
+            for (i = 0; i < count && shown < 64; i++)
+            {
+                if (!VirtualQuery( stack + i, &info, sizeof(info) ) || info.State != MEM_COMMIT) break;
+                if (VirtualQuery( (void *)stack[i], &info, sizeof(info) ) && info.Type == MEM_IMAGE &&
+                    (info.Protect & (PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE)))
+                {
+                    WCHAR name[MAX_PATH];
+                    if (GetModuleFileNameW( info.AllocationBase, name, ARRAY_SIZE(name) ) && wcsstr( name, L"WinStore" ))
+                    {
+                        ERR( "  +%04Ix  WinStore.App+%#Ix\n", i * 8, (SIZE_T)((char *)stack[i] - (char *)info.AllocationBase) );
+                        shown++;
+                    }
+                }
+            }
+        }
+        ResumeThread( thread );
+    }
+    CloseHandle( thread );
+    return 0;
+}
+#endif
