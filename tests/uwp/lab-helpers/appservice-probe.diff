+struct request
+{
+    IAppServiceRequest IAppServiceRequest_iface;
+    LONG ref;
+    IPropertySet *message;
+};
+
+static inline struct request *impl_from_IAppServiceRequest( IAppServiceRequest *iface )
+{
+    return CONTAINING_RECORD( iface, struct request, IAppServiceRequest_iface );
+}
+
+static HRESULT WINAPI request_QueryInterface( IAppServiceRequest *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAppServiceRequest ))
+    {
+        *out = iface;
+        IUnknown_AddRef( (IUnknown *)*out );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI request_AddRef( IAppServiceRequest *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppServiceRequest( iface )->ref );
+}
+
+static ULONG WINAPI request_Release( IAppServiceRequest *iface )
+{
+    struct request *impl = impl_from_IAppServiceRequest( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->message) IPropertySet_Release( impl->message );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI request_GetIids( IAppServiceRequest *iface, ULONG *count, IID **iids )
+{
+    IID *list;
+
+    if (!(list = CoTaskMemAlloc( sizeof(*list) ))) return E_OUTOFMEMORY;
+    *list = IID_IAppServiceRequest;
+    *count = 1;
+    *iids = list;
+    return S_OK;
+}
+
+static HRESULT WINAPI request_GetRuntimeClassName( IAppServiceRequest *iface, HSTRING *name )
+{
+    return WindowsCreateString( L"Windows.ApplicationModel.AppService.AppServiceRequest",
+                                ARRAY_SIZE(L"Windows.ApplicationModel.AppService.AppServiceRequest") - 1, name );
+}
+
+static HRESULT WINAPI request_GetTrustLevel( IAppServiceRequest *iface, TrustLevel *level )
