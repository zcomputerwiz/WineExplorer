 static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
 {
+    static LONG stack_started;
+
     struct connection *impl;
 
     TRACE( "iface %p, instance %p.\n", iface, instance );
 
+    if (GetEnvironmentVariableW( L"WINEAPPSERVICE_STACK", NULL, 0 ) && !InterlockedExchange( &stack_started, 1 ))
+    {
+        HANDLE thread, main_thread;
+
+        DuplicateHandle( GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &main_thread, THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0 );
+        thread = CreateThread( NULL, 0, stack_thread, main_thread, 0, NULL );
+        if (thread) CloseHandle( thread );
+    }
+
     *instance = NULL;
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
     impl->IAppServiceConnection_iface.lpVtbl = &connection_vtbl;
