/*
 * WineExplorer Desktop Environment - Display Properties (desk.cpl) Resources Script
 */

#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_CPL_NAME        "Display Properties"
    IDS_CPL_INFO        "Customizes your desktop display, themes, screen colors, and resolution."
END

/* @makedep: monitor.bmp */
126 BITMAP "monitor.bmp"

/* Themes Property Page */
IDD_THEMES DIALOGEX 0, 0, 252, 218
STYLE WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Themes"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "A theme is a background plus a set of sounds, icons, and other elements to help you personalize your computer with one click.", IDC_STATIC, 7, 7, 238, 20
    LTEXT           "&Theme:", IDC_STATIC, 7, 30, 40, 10
    COMBOBOX        IDC_THEME_LIST, 7, 42, 140, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Save &As...", IDC_THEME_SAVEAS, 155, 41, 42, 14
    PUSHBUTTON      "&Delete", IDC_THEME_DELETE, 202, 41, 42, 14
    LTEXT           "Sample:", IDC_STATIC, 7, 60, 40, 10
    CONTROL         "", IDC_THEME_PREVIEW, "DeskCplPreview", WS_CHILD | WS_VISIBLE | WS_BORDER, 7, 72, 238, 138
END

/* Desktop / Background Property Page */
IDD_BACKGROUND DIALOGEX 0, 0, 252, 218
STYLE WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Desktop"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "", IDC_BG_PREVIEW, "DeskCplPreview", WS_CHILD | WS_VISIBLE, 63, 7, 125, 107
    LTEXT           "&Background:", IDC_STATIC, 7, 114, 50, 10
    LISTBOX         IDC_BG_LIST, 7, 126, 175, 62, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_BG_BROWSE, 190, 126, 55, 14
    LTEXT           "&Position:", IDC_STATIC, 190, 144, 40, 10
    COMBOBOX        IDC_BG_POSITION, 190, 156, 55, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    PUSHBUTTON      "&Color...", IDC_BG_COLOR, 190, 174, 55, 14
    PUSHBUTTON      "&Customize Desktop...", IDC_BG_CUSTDESK, 7, 196, 85, 14
END

/* Appearance Property Page */
IDD_APPEARANCE DIALOGEX 0, 0, 252, 218
STYLE WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Appearance"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "", IDC_APP_PREVIEW, "DeskCplPreview", WS_CHILD | WS_VISIBLE | WS_BORDER, 7, 5, 238, 120
    LTEXT           "&Windows and buttons:", IDC_STATIC, 7, 131, 100, 10
    COMBOBOX        IDC_APP_STYLE, 7, 141, 131, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Color scheme:", IDC_STATIC, 7, 159, 100, 10
    COMBOBOX        IDC_APP_COLORSCHEME, 7, 169, 131, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Font size:", IDC_STATIC, 7, 188, 100, 10
    COMBOBOX        IDC_APP_FONTSIZE, 7, 198, 131, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    PUSHBUTTON      "E&ffects...", IDC_APP_EFFECTS, 190, 180, 55, 14
    PUSHBUTTON      "Ad&vanced", IDC_APP_ADVANCED, 190, 199, 55, 14
END

/* Settings Property Page */
IDD_SETTINGS DIALOGEX 0, 0, 252, 218
STYLE WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "", IDC_SET_MONITOR_IMG, "DeskCplPreview", WS_CHILD | WS_VISIBLE, 63, 7, 125, 107
    LTEXT           "Display:", IDC_STATIC, 7, 116, 40, 10
    LTEXT           "", IDC_SET_DISPLAY_LBL, 7, 128, 238, 16
    GROUPBOX        "Screen resolution", IDC_STATIC, 7, 147, 115, 57
    CONTROL         "", IDC_SET_RES_SLIDER, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ | TBS_AUTOTICKS, 15, 161, 98, 20
    CTEXT           "", IDC_SET_RES_TEXT, 12, 187, 105, 12
    GROUPBOX        "Color quality", IDC_STATIC, 130, 147, 115, 57
    COMBOBOX        IDC_SET_BPP_COMBO, 138, 168, 98, 50, CBS_DROPDOWNLIST | WS_TABSTOP
    PUSHBUTTON      "Ad&vanced", IDC_SET_ADVANCED, 185, 205, 60, 14
END

/* Virtual Desktop Page (Legacy Wine Settings) */
IDD_DESKTOP DIALOGEX 0, 0, 252, 218
STYLE WS_CAPTION | WS_CHILD | WS_DISABLED
CAPTION "Virtual Desktop"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Virtual Desktop Modes", IDC_VIRTUAL_DESKTOP, 7, 7, 238, 90
    LTEXT           "Resolution presets:", IDC_STATIC, 15, 22, 80, 10
    COMBOBOX        IDC_DISPLAY_SETTINGS_LIST, 15, 35, 150, 80, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_TABSTOP
    PUSHBUTTON      "&Reset", IDC_DISPLAY_SETTINGS_RESET, 172, 34, 40, 14
    PUSHBUTTON      "&Apply", IDC_DISPLAY_SETTINGS_APPLY, 172, 52, 40, 14
END

/* Customize Desktop Dialog */
IDD_CUSTDESKTOP DIALOGEX 0, 0, 230, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Desktop Items"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Desktop icons", IDC_STATIC, 7, 7, 216, 75
    AUTOCHECKBOX    "My &Documents", IDC_CUST_MYDOCS, 18, 22, 80, 10
    AUTOCHECKBOX    "My &Computer", IDC_CUST_MYCOMP, 18, 36, 80, 10
    AUTOCHECKBOX    "My &Network Places", IDC_CUST_MYNET, 18, 50, 90, 10
    AUTOCHECKBOX    "&Recycle Bin", IDC_CUST_RECYCLE, 18, 64, 80, 10
    PUSHBUTTON      "&Change Icon...", IDC_CUST_CHANGEICON, 140, 30, 75, 14
    PUSHBUTTON      "&Restore Default", IDC_CUST_DEFAULTICON, 140, 50, 75, 14
    DEFPUSHBUTTON   "OK", IDOK, 115, 158, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 172, 158, 50, 14
END

/* Display Change Confirmation Dialog */
IDD_WAITSETTINGS DIALOGEX 0, 0, 220, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_CENTER
CAPTION "Monitor Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Please wait while your desktop is reconfigured.", IDC_STATIC, 12, 12, 196, 18
    PUSHBUTTON "Cancel", IDCANCEL, 85, 37, 50, 14
END

IDD_CONFIRMSETTINGS DIALOGEX 0, 0, 220, 85
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_CENTER
CAPTION "Monitor Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            ICO_MAIN, IDC_STATIC, 14, 15, 21, 20
    LTEXT           "Your desktop has been reconfigured. Do you want to keep these settings?\n\nReverting in 15 seconds", IDC_CONFIRM_TEXT, 48, 15, 160, 36
    DEFPUSHBUTTON   "&Yes", IDYES, 55, 58, 50, 14
    PUSHBUTTON      "&No", IDNO, 115, 58, 50, 14
END

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* @makedep: desk.manifest */
124 RT_MANIFEST desk.manifest

/* @makedep: desk.ico */
ICO_MAIN ICON "desk.ico"
