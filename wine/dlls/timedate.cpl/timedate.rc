/*
 * WineExplorer Desktop Environment - Date and Time Properties (timedate.cpl) Resources Script
 */

#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

ICO_MAIN ICON "timedate.ico"
IDB_WORLD BITMAP "world.bmp"

STRINGTABLE
BEGIN
    IDS_CPL_NAME        "Date and Time"
    IDS_CPL_INFO        "Set the date, time, and time zone for your computer."
END

/* Date & Time Property Page */
IDD_DATEANDTIME DIALOGEX 0, 0, 252, 218
STYLE WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Date & Time"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Date", IDC_STATIC, 7, 7, 130, 160
    CONTROL         "", IDC_MONTHCAL, "SysMonthCal32", WS_TABSTOP | WS_BORDER, 13, 20, 118, 140
    GROUPBOX        "Time", IDC_STATIC, 143, 7, 102, 160
    CONTROL         "", IDC_CLOCK_CTRL, "TimeDateClock", WS_CHILD | WS_VISIBLE, 153, 20, 82, 82
    CONTROL         "", IDC_TIME_EDIT, "SysDateTimePick32", DTS_TIMEFORMAT | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 150, 115, 88, 14
    LTEXT           "Current time is displayed above.", IDC_STATIC, 150, 140, 90, 22
END

/* Time Zone Property Page */
IDD_TIMEZONE DIALOGEX 0, 0, 252, 218
STYLE WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Time Zone"
FONT 8, "MS Shell Dlg"
BEGIN
    COMBOBOX        IDC_TIMEZONE_LIST, 7, 7, 238, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_TIMEZONE_MAP, "Static", SS_ETCHEDFRAME, 7, 30, 238, 110
    AUTOCHECKBOX    "Automatically adjust clock for daylight saving changes", IDC_TIMEZONE_AUTO, 7, 155, 238, 10
END

/* User Account Control prompt */
IDD_UAC DIALOGEX 0, 0, 246, 188
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "User Account Control"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_UAC_BANNER, "Static", SS_OWNERDRAW, 0, 0, 246, 38
    ICON            ICO_MAIN, IDC_UAC_ICON, 12, 46, 20, 20
    LTEXT           "Program name:", IDC_STATIC, 44, 46, 65, 8
    LTEXT           "", IDC_UAC_PROGRAM, 112, 46, 124, 8
    LTEXT           "Verified publisher:", IDC_STATIC, 44, 58, 65, 8
    LTEXT           "WineExplorer", IDC_UAC_PUB_NAME, 112, 58, 124, 8
    LTEXT           "File origin:", IDC_STATIC, 44, 70, 65, 8
    LTEXT           "Hard drive on this computer", IDC_STATIC, 112, 70, 124, 8
    CONTROL         "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 12, 84, 222, 1
    LTEXT           "", IDC_UAC_PROMPT, 12, 90, 222, 18
    CONTROL         "", IDC_UAC_USERTILE, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 18, 114, 22, 24
    COMBOBOX        IDC_UAC_ACCOUNT, 46, 114, 184, 80, WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Password:", IDC_UAC_PW_LABEL, 46, 134, 38, 8, WS_CHILD
    EDITTEXT        IDC_UAC_PASSWORD, 86, 132, 144, 13, WS_CHILD | ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "&Yes", IDYES, 132, 164, 50, 14
    PUSHBUTTON      "&No", IDNO, 186, 164, 50, 14
END

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* @makedep: timedate.manifest */
124 RT_MANIFEST timedate.manifest
