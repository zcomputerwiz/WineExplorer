MODULE    = explorer.exe
IMPORTS   = rpcrt4 user32 gdi32 advapi32 win32u
DELAYIMPORTS = comctl32 shell32 oleaut32 ole32 shlwapi uxtheme winmm

EXTRADLLFLAGS = -mwindows -municode

VER_FILEDESCRIPTION_STR = "Wine Explorer Desktop Environment"
VER_PRODUCTVERSION      = 6,1,7601,17567

SOURCES = \
	appbar.c \
	desktop.c \
	desktop_view.c \
	explorer.c \
	explorer.rc \
	power_mgmt.c \
	startmenu.c \
	startmenu_view.c \
	systray.c \
	taskband.c \
	taskbar_props.c \
	theme_engine.c \
	tray_clock.c
