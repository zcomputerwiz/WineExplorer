#include "windef.h"
#include "winuser.h"
#include "commctrl.h"
#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

1 ICON "explorer.ico"

STRINGTABLE
{
    IDS_EXPLORER_TITLE  "Wine Explorer"
    IDS_PATHBOX_LABEL   "Address"
    IDS_START_LABEL     "Start"
    IDS_RUN             "&Run..."
    IDS_EXIT_LABEL      "E&xit desktop"
    IDS_EXIT_PROMPT     "Are you sure you want to close all programs and exit the virtual desktop?"
    IDS_DESKTOP_TITLE   "Wine Desktop"
}

/* Taskbar Property Page (DLG_TRAY_OPTIONS of the Windows shell) */
IDD_TASKBARPROP DIALOGEX 0, 0, 252, 218
STYLE WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Taskbar"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Taskbar appearance", -1, 6, 6, 240, 104
    CONTROL         "", IDC_TASKBAR_PREVIEW, "Static", SS_OWNERDRAW | SS_SUNKEN, 13, 18, 223, 28
    AUTOCHECKBOX    "&Lock the taskbar", IDC_LOCKTASKBAR, 13, 45, 200, 10, WS_TABSTOP
    AUTOCHECKBOX    "A&uto-hide the taskbar", IDC_AUTOHIDETASKBAR, 13, 58, 200, 10, WS_TABSTOP
    AUTOCHECKBOX    "Keep the &taskbar on top of other windows", IDC_ONTOPTASKBAR, 13, 71, 200, 10, WS_TABSTOP
    AUTOCHECKBOX    "&Group similar taskbar buttons", IDC_GROUPTASKBAR, 13, 84, 200, 10, WS_TABSTOP
    AUTOCHECKBOX    "Show &Quick Launch", IDC_QUICKLAUNCH, 13, 97, 200, 10, WS_TABSTOP

    GROUPBOX        "Notification area", -1, 6, 114, 240, 98
    CONTROL         "", IDC_NOTIFY_PREVIEW, "Static", SS_OWNERDRAW | SS_SUNKEN, 13, 126, 223, 28
    AUTOCHECKBOX    "Show the cloc&k", IDC_SHOWCLOCK, 13, 153, 200, 10, WS_TABSTOP
    LTEXT           "You can keep the notification area uncluttered by hiding icons that you have not clicked recently.", -1, 13, 169, 223, 16
    AUTOCHECKBOX    "&Hide inactive icons", IDC_HIDEINACTIVEICONS, 13, 191, 125, 10, WS_TABSTOP
    PUSHBUTTON      "&Customize...", IDC_CUSTOMIZE, 188, 191, 50, 14
END

/* Start Menu Property Page (DLG_START of the Windows shell) */
IDD_STARTMENUPROP DIALOGEX 0, 0, 252, 218
STYLE WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Start Menu"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "", IDC_START_PREVIEW, "Static", SS_OWNERDRAW | SS_SUNKEN, 7, 7, 183, 108
    AUTORADIOBUTTON "&Start menu", IDC_NEWSCHOOL, 7, 135, 105, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "Select this menu style for easy access to the Internet, e-mail, and your favorite programs.", IDC_NEWSCHOOLDESCRIPTION, 20, 145, 150, 24
    AUTORADIOBUTTON "Classic Start &menu", IDC_OLDSCHOOL, 7, 175, 105, 10
    LTEXT           "Select this option to use the menu style from earlier versions of Windows.", -1, 20, 185, 150, 24
    PUSHBUTTON      "&Customize...", IDC_NEWSTARTCUSTOMIZE, 192, 132, 53, 14
    PUSHBUTTON      "&Customize...", IDC_OLDSTARTCUSTOMIZE, 192, 172, 53, 14
END

/* Customize Start Menu: General */
IDD_START_GENERAL DIALOGEX 0, 0, 251, 198
STYLE WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "General"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Select an icon size for programs ", -1, 7, 7, 238, 37
    AUTORADIOBUTTON "&Large icons", IDC_SPCUST_LARGE, 43, 25, 80, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Small icons", IDC_SPCUST_SMALL, 177, 25, 60, 10
    GROUPBOX        "Programs ", -1, 7, 49, 238, 70
    LTEXT           "The Start menu contains shortcuts to the programs you use most often.  Clearing the list of shortcuts does not delete the programs.", -1, 14, 63, 224, 20
    LTEXT           "&Number of programs on Start menu:", -1, 14, 86, 112, 8
    EDITTEXT        IDC_SPCUST_MINPROGS, 133, 84, 27, 12, ES_RIGHT | ES_NUMBER | WS_TABSTOP | WS_GROUP
    CONTROL         "", IDC_SPCUST_MINPROGS_ARROW, "msctls_updown32", UDS_AUTOBUDDY | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS | WS_GROUP, 160, 84, 11, 12
    PUSHBUTTON      "&Clear List", IDB_SPCUST_CLEARPROG, 182, 98, 57, 14
    GROUPBOX        "Show on Start menu ", -1, 7, 126, 238, 63
    AUTOCHECKBOX    "&Internet:", IDC_SPCUST_INTERNET, 14, 140, 42, 10, WS_TABSTOP
    COMBOBOX        IDC_SPCUST_INTERNETCB, 98, 138, 140, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&E-mail:", IDC_SPCUST_EMAIL, 14, 157, 37, 10, WS_TABSTOP
    COMBOBOX        IDC_SPCUST_EMAILCB, 98, 155, 140, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

/* Customize Start Menu: Advanced */
IDD_START_ADVANCED DIALOGEX 0, 0, 251, 198
STYLE WS_CHILD | WS_CAPTION | WS_DISABLED
CAPTION "Advanced"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Start menu settings ", -1, 7, 7, 238, 42
    AUTOCHECKBOX    "&Open submenus when I pause on them with my mouse", IDC_SPCUST_HOVEROPEN, 14, 21, 224, 10, WS_TABSTOP
    AUTOCHECKBOX    "Highlight &newly installed programs", IDC_SPCUST_NOTIFYNEW, 14, 35, 224, 10, WS_TABSTOP
    LTEXT           "Start &menu items:", -1, 7, 53, 238, 8
    CONTROL         "StartMenuSe&ttings", IDC_STARTMENUSETTINGS, "SysTreeView32", TVS_HASBUTTONS | WS_BORDER | WS_TABSTOP, 7, 63, 238, 67, WS_EX_CLIENTEDGE
    GROUPBOX        "Recent documents ", -1, 7, 133, 238, 56
    LTEXT           "Select this option to provide quick access to the documents you opened most recently.  Clearing this list does not delete the documents.", -1, 14, 144, 224, 21
    AUTOCHECKBOX    "List my most &recently opened documents", IDC_SPCUST_RECENT, 14, 168, 147, 10, WS_TABSTOP
    PUSHBUTTON      "&Clear List", IDB_SPCUST_CLEARDOCS, 182, 168, 55, 14
END

/* Customize Classic Start Menu (DLG_STARTMENU_CONFIG of the Windows shell) */
IDD_CLASSIC_CUSTOMIZE DIALOGEX 0, 0, 232, 240
STYLE DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Customize Classic Start Menu"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Start menu", -1, 8, 7, 218, 114
    LTEXT           "You can customize your Start menu by adding or removing items.", -1, 48, 17, 108, 39
    PUSHBUTTON      "A&dd...", IDC_ADDSHORTCUT, 162, 18, 53, 14
    PUSHBUTTON      "&Remove...", IDC_DELSHORTCUT, 162, 33, 53, 14
    PUSHBUTTON      "Ad&vanced", IDC_EXPLOREMENUS, 162, 49, 53, 14
    PUSHBUTTON      "&Sort", IDC_RESORT, 162, 65, 53, 14
    LTEXT           "To remove records of recently accessed documents, programs, and Web sites, click Clear.", -1, 49, 85, 108, 33
    PUSHBUTTON      "&Clear", IDC_KILLDOCUMENTS, 162, 94, 53, 14
    LTEXT           "Advanced S&tart menu options:", -1, 8, 129, 150, 8
    CONTROL         "StartMenuSe&ttings", IDC_STARTMENUSETTINGS, "SysTreeView32", WS_BORDER | WS_TABSTOP | TVS_HASBUTTONS, 8, 139, 218, 72, WS_EX_CLIENTEDGE
    DEFPUSHBUTTON   "OK", IDOK, 122, 220, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 176, 220, 50, 14
END

/* Customize Notifications (DLG_NOTIFY of the Windows shell) */
IDD_NOTIFY_CUSTOMIZE DIALOGEX 0, 0, 232, 240
STYLE DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Customize Notifications"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Windows displays icons for active and urgent notifications, and hides inactive ones. You can change this behavior for items in the list below.", -1, 6, 6, 220, 30
    LTEXT           "Select an item, then choose its notification behavior:", -1, 6, 40, 220, 10
    CONTROL         "List1", IDC_NOTIFY_ITEMS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | LVS_SHOWSELALWAYS | WS_CLIPSIBLINGS | WS_BORDER | WS_TABSTOP, 6, 50, 220, 128
    COMBOBOX        IDC_COMBO_ACTION, 103, 178, 78, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_CLIPSIBLINGS
    PUSHBUTTON      "&Restore Defaults", IDB_NOTIFY_RESTOREDEFAULTS, 164, 200, 62, 14
    DEFPUSHBUTTON   "OK", IDOK, 122, 220, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 176, 220, 50, 14
END

