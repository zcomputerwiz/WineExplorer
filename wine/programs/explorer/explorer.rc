/* Authentic Windows XP / Server 2003 Tray Volume Dialog */
IDD_TRAYMASTER DIALOGEX 0, 0, 52, 90
STYLE DS_MODALFRAME | WS_POPUP
EXSTYLE WS_EX_TOOLWINDOW
FONT 8, "MS Shell Dlg"
BEGIN
    CTEXT           "Volume", IDC_TRAY_VOLUME_LABEL, 0, 4, 52, 8
    CONTROL         "", IDC_TRAY_VOLUME_SLIDER, "msctls_trackbar32",
                    TBS_VERT | TBS_BOTH | TBS_NOTICKS | WS_CHILD | WS_VISIBLE | WS_TABSTOP,
                    16, 14, 20, 60
    AUTOCHECKBOX    "&Mute", IDC_TRAY_VOLUME_MUTE, 4, 76, 44, 10
END

/* polkit authentication prompt (UAC style) */
IDD_UAC DIALOGEX 0, 0, 246, 170
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "User Account Control"
FONT 8, "Tahoma"
BEGIN
    CONTROL         "", IDC_UAC_BANNER, "Static", SS_OWNERDRAW, 0, 0, 246, 38
    LTEXT           "Action:", -1, 12, 46, 34, 8
    LTEXT           "", IDC_UAC_PROGRAM, 50, 46, 184, 24
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 12, 74, 222, 1
    LTEXT           "", IDC_UAC_PROMPT, 12, 80, 222, 18
    CONTROL         "", IDC_UAC_USERTILE, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 18, 106, 22, 24
    COMBOBOX        IDC_UAC_ACCOUNT, 46, 106, 184, 80, WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Password:", IDC_UAC_PW_LABEL, 46, 127, 38, 8
    EDITTEXT        IDC_UAC_PASSWORD, 86, 125, 144, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "", IDC_UAC_ERROR, 12, 150, 118, 16
    DEFPUSHBUTTON   "&Yes", IDYES, 132, 149, 50, 14
    PUSHBUTTON      "&No", IDNO, 186, 149, 50, 14
END

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* @makedep: explorer.manifest */
1 RT_MANIFEST explorer.manifest

