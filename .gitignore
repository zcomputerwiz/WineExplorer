# ====================================================================
# Git Ignore for WineExplorer Desktop Environment Project
# ====================================================================

# Archive files
*.zip
*.tar.*
*.7z
*.gz
*.xz
/archives/

# External reference repositories (kept locally for reference only; NEVER committed)
/references/
assets/_ms_originals/

# Build artifacts & temporary files
build/
bin/
obj/
*.o
*.a
*.so
*.dll
*.exe
!wine/dlls/ntoskrnl.exe/
!wine/dlls/ntoskrnl.exe/**
*.res
*.obj
*.pdb
*.orig
*.rej
*.patch
autom4te.cache/
wine/autom4te.cache/

# Editor and OS files
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# VM sync stamp / screenshots
.vm_synced_commit
vm_shot.png
xp_shot.png
evidence-ui/
installer/*.iso
installer/*.vdi
installer/*.deb
sync.ffs_db
installer/**/*.deb
installer/**/*.iso
installer/**/*.vdi
installer/**/*.raw
installer/textsetup/textsetup
installer/live-build/config/includes.chroot/setup/textsetup
wine/programs/*/*.exe

# Python bytecode
__pycache__/
*.py[cod]
*.tmp

# wexprefetchd build outputs
/src/wexprefetchd/wexprefetchd
/src/wexprefetchd/wexpf-client
/src/wexprefetchd/test_sha256
